{
  "dest_root": "~/Backup",
  "poll_seconds": 3,
  "include_fixed_drives": true,
  "notify": true,
  "rescan_cooldown_minutes": 15,
  "missing_polls_before_removed": 3,
  "copy_threads": 8,
  "keep_versions": false,
  "low_priority": true,
  "notify_errors": true,
  "dst_tolerance": true,
  "verify_percent": 1,
  "use_gitignore": false,
  "stale_days": 7,
  "language": "auto",
  "autostart": true,
  "run_on_start": true,
  "close_to_tray": true,
  "start_minimized": false,
  "heartbeat_minutes": 0,
  "log_file": "~/Backup/_logs/usb-backup.log",
  "default_exclude": [
    "System Volume Information",
    "$RECYCLE.BIN",
    ".Spotlight-V100",
    ".Trashes",
    ".fseventsd",
    "._*",
    "Thumbs.db",
    ".DS_Store"
  ]
}
